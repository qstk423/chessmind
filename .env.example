# LLM API 配置（OpenAI 兼容）
# 大赛提交 / 决赛现场：填天津移动下发的 Key 与 Base URL，模型保持 glm-5.1
# 日常开发：可临时改为千问等（例：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 ，LLM_MODEL=qwen-plus）
# 留空 Key 则纯引擎模式：走子、评分正常，Agent / LLM 选着跳过
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=glm-5.1

# Stockfish 引擎路径（按系统修改，或留空使用 PATH 中的 stockfish）：
# - macOS Apple Silicon: /opt/homebrew/bin/stockfish
# - macOS Intel:         /usr/local/bin/stockfish
# - Ubuntu/Debian:       /usr/games/stockfish
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# 算法对抗中引擎方默认深度
# AI_ENGINE_DEPTH=12

# 教练讲解水平：beginner | intermediate | advanced
# COACH_LEVEL=intermediate
# 分歧达到该阈值触发辩论（0~1）
# DEBATE_THRESHOLD=0.5
# 多模态识谱（阿里云百炼请开通并填写，例如 qwen-vl-plus / qwen3-vl-plus）
VISION_MODEL=qwen-vl-plus

# 联机部署（手机互下）：默认监听全网卡；仅本机可改 127.0.0.1
HOST=0.0.0.0
PORT=8000
# 前后端分离时再收紧；同源部署保持 *
CORS_ORIGINS=*

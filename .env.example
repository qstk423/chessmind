# LLM：天津移动 Token 算力大赛下发的 glm-5.1（OpenAI 兼容）
# Base URL 填到 /v1 为止（不要带 /chat/completions）
# 留空 Key 则纯引擎模式：走子、评分正常，Council / LLM 选着跳过
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 大赛校园网网关示例：http://111.32.22.35:32592/mgate/v1
LLM_MODEL=glm-5.1
# 大赛网关一般无需 thinking；保持 disabled
LLM_THINKING=disabled

# 千问：AI vs AI 对决第二方（阿里云百炼；与大赛 GLM 分开填 Key）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Stockfish 引擎路径（按系统修改，或留空使用 PATH 中的 stockfish）：
# - macOS Apple Silicon: /opt/homebrew/bin/stockfish
# - macOS Intel:         /usr/local/bin/stockfish
# - Ubuntu/Debian:       /usr/games/stockfish
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# 中国象棋引擎（可选；有则强度接近国际象棋侧 Stockfish）：
# 不设也会自动探测 engines/Pikafish/src/pikafish（先跑 ./scripts/build_pikafish.sh）
# PIKAFISH_PATH=/Users/you/chessmind/engines/Pikafish/src/pikafish
# XIANGQI_AI_STRENGTH=normal   # easy | normal | hard

# 算法对抗中引擎方默认深度
# AI_ENGINE_DEPTH=12

# 教练讲解水平：beginner | intermediate | advanced
# COACH_LEVEL=intermediate
# 分歧达到该阈值触发辩论（0~1）
# DEBATE_THRESHOLD=0.5
# 多模态识谱（智谱可用 glm-4v-plus；开发期也可用百炼 qwen-vl-plus）
VISION_MODEL=glm-4v-plus

# 联机部署（手机互下）：默认监听全网卡；仅本机可改 127.0.0.1
HOST=0.0.0.0
PORT=8000
# 前后端分离时再收紧；同源部署保持 *
CORS_ORIGINS=*

# —— 上线护栏（公开展示建议开启）——
# PUBLIC_DEMO=1
# ADMIN_TOKEN=change-me
# LLM_TIMEOUT_SEC=60
# LLM_MAX_CONCURRENT=1
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_BURST=90
# PGN_MAX_PLIES=40
